// Layour and desktop config

layout {
    background-color "transparent"
    gaps 20

    shadow {
        on
        softness 4
        spread 0
        color "#1a1a1aee"
    }

    center-focused-column "never"

    focus-ring {
        width 2

        active-gradient from="#b4befe" to="#eff1f5" angle=45
        inactive-color "#585b70"
    }

}

overview {
    workspace-shadow {
        off
    }
}
