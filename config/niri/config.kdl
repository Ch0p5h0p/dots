// Chop's Niri Config

prefer-no-csd
environment {
    XCURSOR_SIZE "24"
    HYPRCURSOR_SIZE "24"
    QT_QPA_PLATFORMTHEME "qt6ct"
    BROWSER "firefox"
    VISUAL "zeditor"
    EDITOR "nvim"
}

output "eDP-1" {
    mode "1920x1080@120"
    scale 1
}

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad { 
        natural-scroll
    }
}
gestures {
    hot-corners {
        off
    }
}

layout {
    gaps 20

    shadow {
        on
        softness 4
        spread 0
        color "#1a1a1aee"
    }

    center-focused-column "never"

    focus-ring {
        width 2

        active-gradient from="#b4befe" to="#eff1f5" angle=45
        inactive-color "#585b70"
    }

}

window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
}

blur {
    passes 1
}

screenshot-path "~/Media/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// For the future, put animations here

hotkey-overlay {
    skip-at-startup
}

spawn-sh-at-startup "noctalia &"
spawn-sh-at-startup "kitty --detach --title 'kitty-daemon' --single-instance sh -c 'exit'"
spawn-sh-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-sh-at-startup "nm-applet &"
spawn-sh-at-startup "gsr-ui launch-hide"
spawn-sh-at-startup "vesktop --start-minimized"
spawn-sh-at-startup "steam -silent"

binds {
    Mod+T {
        spawn-sh "kitty -1"
    }

    Mod+Q {
        close-window
    }
    
    Mod+W {
        toggle-overview
    }

    Mod+M {
        spawn-sh "noctalia msg session lock"
    }

    Mod+Shift+M {
        spawn-sh "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || niri msg action quit"
    }

    Mod+E {
        spawn-sh "alacritty -e nvim"
    }

    Mod+Shift+E {
        spawn "zeditor"
    }

    Mod+D {
        spawn-sh "kitty -1 -- ranger"
    }

    Mod+Shift+D {
        spawn "dolphin"
    }

    Mod+R {
        spawn-sh "noctalia msg panel-toggle launcher"
    } 

    Mod+F {
        maximize-column
    }

    Mod+Shift+F {
        fullscreen-window
    }

    Mod+Shift+W {
        spawn-sh "noctalia msg panel-toggle wallpaper"
    }

    Mod+Shift+Space {
        spawn-sh "noctalia msg screenshot-fullscreen"
    }

    Mod+Space {
        spawn-sh "noctalia msg screenshot-region"
    }

    Mod+C {
        spawn-sh "noctalia msg panel-toggle control-center"
    }

    Mod+N {
        spawn-sh "noctalia msg panel-toggle noctalia/notes:panel"
    }

    Mod+A {
        spawn-sh "kitty -- todo read main"
    }

    Mod+Left {
        focus-column-left
    }

    Mod+Right {
        focus-column-right
    }

    Mod+Up {
        focus-window-up
    }

    Mod+Down {
        focus-window-down
    }

   Mod+Shift+Left {
        move-column-left
    }

    Mod+Shift+Right {
        move-column-right
    }

    Mod+Shift+Up {
        move-window-up
    }

    Mod+Shift+Down {
        move-window-down
    }

    Mod+1 {
        focus-workspace 1
    }

    Mod+2 {
        focus-workspace 2
    }

    Mod+3 {
        focus-workspace 3
    }

    Mod+4 {
        focus-workspace 4
    }

    Mod+5 {
        focus-workspace 5
    }

    Mod+6 {
        focus-workspace 6
    }

    Mod+7 {
        focus-workspace 7
    }

    Mod+8 {
        focus-workspace 8
    }

    Mod+9 {
        focus-workspace 9
    }

    Mod+0 {
        focus-workspace 10
    }

    // Move column to workspace.
    Mod+Shift+1 {
        move-column-to-workspace 1
    }

    Mod+Shift+2 {
        move-column-to-workspace 2
    }

    Mod+Shift+3 {
        move-column-to-workspace 3
    }

    Mod+Shift+4 {
        move-column-to-workspace 4
    }

    Mod+Shift+5 {
        move-column-to-workspace 5
    }

    Mod+Shift+6 {
        move-column-to-workspace 6
    }

    Mod+Shift+7 {
        move-column-to-workspace 7
    }

    Mod+Shift+8 {
        move-column-to-workspace 8
    }

    Mod+Shift+9 {
        move-column-to-workspace 9
    }

    Mod+Shift+0 {
        move-column-to-workspace 10
    }

    Mod+WheelScrollDown {
        focus-workspace-down
    }

    Mod+WheelScrollUp {
        focus-workspace-up
    }

    Alt+Tab {
        focus-workspace-previous
    }

    Alt+Shift+Tab {
        focus-workspace-previous
    }

    XF86AudioRaiseVolume allow-when-locked=true repeat=true {
        spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"
    }

    XF86AudioLowerVolume allow-when-locked=true repeat=true {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    }

    XF86AudioMute allow-when-locked=true repeat=true {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    }

    XF86AudioMicMute allow-when-locked=true repeat=true {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
    }

    XF86MonBrightnessUp allow-when-locked=true repeat=true {
        spawn-sh "brightnessctl -e4 -n2 set 5%+"
    }

    XF86MonBrightnessDown allow-when-locked=true repeat=true {
        spawn-sh "brightnessctl -e4 -n2 set 5%-"
    }

    XF86AudioNext allow-when-locked=true {
        spawn "playerctl" "next"
    }

    XF86AudioPause allow-when-locked=true {
        spawn "playerctl" "play-pause"
    }

    XF86AudioPlay allow-when-locked=true {
        spawn "playerctl" "play-pause"
    }

    XF86AudioPrev allow-when-locked=true {
        spawn "playerctl" "previous"
    }
}
